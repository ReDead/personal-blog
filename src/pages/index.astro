---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import BasicLink from '../components/BasicLink.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Howdy!</h1>
			<p>
				Welcome to my website.
			</p>
			<p>
				I'm not much of a social media person, but I like writing about the things I'm doing sometimes. I also know that I have people in my life who are avid social media users and like to see updates about my life. If that is you, this is the best you get 😀. Sorry, not sorry.
			</p>
			<p>
				I also explain things here in much greater detail than feels appropriate on social media or in texts. So if your interested in getting all the details and my thought process behind things, this is it.
			</p>
		</main>
		<Footer />
	</body>
</html>
